{
  "schemaVersion": 2,
  "status": "non-deployed-foundation",
  "sourceOfTruth": {
    "rule": "Markdown bodies and front matter, project Markdown, and the main BibTeX file are canonical. This contract is validation metadata only and must not become a content store.",
    "canonicalSchema": "The complete canonical schema remains the Astro collection/configuration schemas and BibTeX parser. A service must validate against those sources as well as this contract and reject unknown fields.",
    "prohibited": ["database", "authoritative JSON content mirror"]
  },
  "sourceWriteBoundary": {
    "canonicalRootsOrFiles": [
      "src/site.config.ts",
      "src/content/blog",
      "src/content/projects",
      "src/content/publications/main.bib",
      "public/img"
    ],
    "pathRules": {
      "repositoryRelativeOnly": true,
      "normalized": true,
      "nonTraversing": true,
      "clientSelectedPaths": false,
      "writesOutsideContractRoots": false,
      "forbidden": [
        "absolute paths",
        ".. path segments",
        "arbitrary config files",
        "code files",
        "deployment files",
        "lockfiles"
      ]
    }
  },
  "collections": {
    "profile": {
      "canonicalSourcePaths": ["src/site.config.ts"],
      "stateBehavior": "May publish immediately through an approved Git change.",
      "editableObject": "PROFILE",
      "fieldPolicies": {
        "name": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 120
        },
        "othernames": {
          "type": ["string", "string[]"],
          "required": false,
          "itemMinLength": 1,
          "maxLength": 120,
          "maxItems": 12
        },
        "tagline": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "required": true,
          "format": "email",
          "maxLength": 254
        },
        "location": { "type": "string", "required": false, "maxLength": 50 },
        "phone": {
          "type": "string",
          "required": false,
          "format": "international-phone",
          "pattern": "^[+]?[\\d\\s().-]{7,22}$"
        },
        "pronouns": { "type": "string", "required": false, "maxLength": 20 },
        "pronunciation": {
          "type": "string",
          "required": false,
          "maxLength": 200
        },
        "pronunciationAudioPath": {
          "type": "string",
          "required": false,
          "format": "public-path"
        },
        "links": {
          "type": "record",
          "required": true,
          "values": ["string", "object:{href:string,label?:string|platform}"]
        },
        "researchInterests": {
          "type": "object[]",
          "required": true,
          "maxItems": 6,
          "itemFields": {
            "label": {
              "type": "string",
              "required": true,
              "minLength": 1,
              "maxLength": 60
            },
            "href": {
              "type": "string",
              "required": false,
              "minLength": 1,
              "format": "url-or-site-path"
            }
          },
          "rejectUnknownItemFields": true
        },
        "linksPlacement": {
          "type": "object",
          "required": false,
          "fields": {
            "header": { "type": ["boolean", "string[]"], "required": false },
            "about": { "type": ["boolean", "string[]"], "required": false },
            "footer": { "type": ["boolean", "string[]"], "required": false }
          },
          "rejectUnknownFields": true
        }
      },
      "rejectUnknownFields": true
    },
    "posts": {
      "canonicalSourcePaths": ["src/content/blog"],
      "stateBehavior": "Draft, review, and publish occur on a protected Git branch or pull request; only a merged change is published.",
      "fieldPolicies": {
        "title": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "required": false,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "required": true,
          "format": "date-or-ISO-datetime"
        },
        "updatedAt": {
          "type": "string",
          "required": false,
          "format": "date-or-ISO-datetime"
        },
        "order": { "type": "number", "required": false },
        "image": {
          "type": "string",
          "required": false,
          "format": "contract-media-reference"
        },
        "tags": {
          "type": "string[]",
          "required": true,
          "maxItems": 30,
          "itemMinLength": 1,
          "itemMaxLength": 80
        },
        "authors": {
          "type": "string[]",
          "required": true,
          "maxItems": 30,
          "itemMinLength": 1
        },
        "draft": { "type": "boolean", "required": true },
        "stage": {
          "type": "string",
          "required": false,
          "allowedValues": ["seedling", "budding", "evergreen"]
        },
        "audience": { "type": "string", "required": false, "maxLength": 300 },
        "body": { "type": "markdown", "required": true, "maxBytes": 262144 }
      },
      "crossFieldRules": [
        "updatedAt must be after createdAt when both are present"
      ],
      "rejectUnknownFields": true
    },
    "projects": {
      "canonicalSourcePaths": ["src/content/projects"],
      "stateBehavior": "Draft, review, and publish occur on a protected Git branch or pull request; only a merged change is published.",
      "fieldPolicies": {
        "title": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 75
        },
        "selected": { "type": "boolean", "required": true },
        "fromDate": {
          "type": "string",
          "required": false,
          "format": "YYYY-MM"
        },
        "toDate": { "type": "string", "required": false, "format": "YYYY-MM" },
        "code": { "type": "string", "required": false, "format": "url" },
        "doc": { "type": "string", "required": false, "format": "url" },
        "paper": { "type": "string", "required": false, "format": "url" },
        "url": { "type": "string", "required": false, "format": "url" },
        "release": { "type": "string", "required": false, "format": "url" },
        "types": {
          "type": "string[]",
          "required": true,
          "allowedValues": [
            "research",
            "product",
            "tool",
            "open-source",
            "coursework"
          ]
        },
        "skills": {
          "type": "string[]",
          "required": true,
          "itemMinLength": 1,
          "itemMaxLength": 80,
          "maxItems": 30
        },
        "description": {
          "type": "string",
          "required": false,
          "maxLength": 200
        },
        "parentProject": {
          "type": "string",
          "required": false,
          "minLength": 1,
          "maxLength": 120
        },
        "timelineLabel": {
          "type": "string",
          "required": false,
          "minLength": 1,
          "maxLength": 80
        },
        "timelineOrder": { "type": "integer", "required": false, "minimum": 0 },
        "researchQuestion": {
          "type": "string",
          "required": false,
          "minLength": 1,
          "maxLength": 260
        },
        "contribution": {
          "type": "string",
          "required": false,
          "minLength": 1,
          "maxLength": 260
        },
        "relatedPublications": {
          "type": "string[]",
          "required": true,
          "itemMinLength": 1,
          "maxItems": 30
        },
        "body": { "type": "markdown", "required": true, "maxBytes": 262144 }
      },
      "crossFieldRules": [
        "toDate must be on or after fromDate when both are present"
      ],
      "rejectUnknownFields": true
    },
    "publications": {
      "canonicalSourcePaths": ["src/content/publications/main.bib"],
      "stateBehavior": "Publication metadata changes are reviewed as Git changes before publication.",
      "fieldPolicies": {
        "entryType": {
          "type": "string",
          "required": true,
          "format": "bibtex-entry-type"
        },
        "citationKey": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 160,
          "format": "bibtex-citation-key"
        },
        "title": {
          "type": "string",
          "required": false,
          "minLength": 1,
          "maxLength": 500
        },
        "author": {
          "type": "string",
          "required": false,
          "minLength": 1,
          "maxLength": 4000
        },
        "year": {
          "type": ["string", "integer"],
          "required": false,
          "format": "year"
        },
        "month": { "type": "string", "required": false, "maxLength": 20 },
        "journal": { "type": "string", "required": false, "maxLength": 500 },
        "booktitle": { "type": "string", "required": false, "maxLength": 500 },
        "volume": { "type": "string", "required": false, "maxLength": 80 },
        "number": { "type": "string", "required": false, "maxLength": 80 },
        "pages": { "type": "string", "required": false, "maxLength": 80 },
        "doi": {
          "type": "string",
          "required": false,
          "format": "doi",
          "maxLength": 255
        },
        "url": { "type": "string", "required": false, "format": "url" },
        "pdf": {
          "type": "string",
          "required": false,
          "format": "url-or-site-path"
        },
        "publisher": { "type": "string", "required": false, "maxLength": 500 },
        "organization": {
          "type": "string",
          "required": false,
          "maxLength": 500
        },
        "school": { "type": "string", "required": false, "maxLength": 500 },
        "note": { "type": "string", "required": false, "maxLength": 2000 },
        "selected": { "type": "boolean", "required": false },
        "image": {
          "type": "string",
          "required": false,
          "format": "contract-media-reference"
        },
        "keywords": { "type": "string", "required": false, "maxLength": 1000 },
        "summary": {
          "type": "string",
          "required": false,
          "minLength": 1,
          "maxLength": 1000
        },
        "contribution": {
          "type": "string",
          "required": false,
          "minLength": 1,
          "maxLength": 1000
        },
        "project": {
          "type": "string",
          "required": false,
          "minLength": 1,
          "maxLength": 160
        }
      },
      "rejectUnknownFields": true
    }
  },
  "permittedMetadata": {
    "projects": [
      "title",
      "selected",
      "fromDate",
      "toDate",
      "code",
      "doc",
      "paper",
      "url",
      "release",
      "types",
      "skills",
      "description",
      "parentProject",
      "timelineLabel",
      "timelineOrder",
      "researchQuestion",
      "contribution",
      "relatedPublications"
    ],
    "bibtex": [
      "title",
      "author",
      "year",
      "month",
      "journal",
      "booktitle",
      "volume",
      "number",
      "pages",
      "doi",
      "url",
      "pdf",
      "publisher",
      "organization",
      "school",
      "note",
      "selected",
      "image",
      "keywords",
      "summary",
      "contribution",
      "project"
    ]
  },
  "media": {
    "canonicalSourcePaths": ["public/img"],
    "firstAllowedClasses": [
      {
        "name": "jpeg",
        "mimeTypes": ["image/jpeg"],
        "maxBytes": 10485760,
        "maxWidth": 8192,
        "maxHeight": 8192,
        "maxDecodedPixels": 40000000
      },
      {
        "name": "png",
        "mimeTypes": ["image/png"],
        "maxBytes": 10485760,
        "maxWidth": 8192,
        "maxHeight": 8192,
        "maxDecodedPixels": 40000000
      },
      {
        "name": "webp",
        "mimeTypes": ["image/webp"],
        "maxBytes": 10485760,
        "maxWidth": 8192,
        "maxHeight": 8192,
        "maxDecodedPixels": 40000000
      },
      {
        "name": "avif",
        "mimeTypes": ["image/avif"],
        "maxBytes": 10485760,
        "maxWidth": 8192,
        "maxHeight": 8192,
        "maxDecodedPixels": 40000000
      }
    ],
    "inspection": {
      "serverSideDecodedInspectionRequired": true,
      "forbiddenFormats": ["image/svg+xml", "svg"],
      "deferredClasses": ["pdf", "video"]
    },
    "generatedFilename": {
      "serverGeneratedOnly": true,
      "pathPattern": "public/img/[a-z0-9][a-z0-9-]{0,79}-(?:[a-f0-9]{16})\\.(?:jpg|png|webp|avif)",
      "noClientFilenameOrPath": true
    },
    "payloadMapping": {
      "imageReferenceFormat": "/img/<generated-filename>",
      "altTextField": "altText",
      "altTextRequired": true,
      "altTextMinLength": 1,
      "altTextMaxLength": 250,
      "decorativeImages": {
        "allowed": true,
        "flagField": "decorative",
        "whenTrue": "altText must be exactly empty",
        "whenFalseOrAbsent": "altText must be nonempty descriptive text"
      }
    },
    "requiredMetadata": ["altText"]
  },
  "authorization": {
    "jwt": {
      "required": true,
      "verifyOnEveryRequest": true,
      "verify": [
        "signature",
        "issuer",
        "audience",
        "expiry",
        "applicable claims"
      ],
      "jwks": {
        "fetchAndRefresh": true,
        "failureMode": "fail-closed for absent, invalid, unavailable, or refresh-failed JWKS"
      },
      "failureMode": "fail-closed for absent or invalid JWT"
    },
    "ownerIdentity": {
      "claim": "email",
      "normalization": "lowercase",
      "match": "exact allow-list match after verified JWT",
      "allowListRole": "defense in depth"
    },
    "audit": {
      "requiredFields": [
        "timestamp",
        "actionId",
        "idempotencyKey",
        "authenticatedOwnerEmail",
        "operation",
        "canonicalPaths",
        "baseRevision",
        "result",
        "failureReason"
      ],
      "redactSecrets": true,
      "retention": "defined before deployment",
      "access": "restricted to authorized operators"
    },
    "conflicts": {
      "neverOverwrite": true,
      "requireFreshDiffAndReview": true,
      "onBaseRevisionMismatch": "reject and require reload, fresh diff, and review"
    },
    "idempotency": {
      "required": true,
      "actionId": "server-generated unique action ID",
      "idempotencyKey": "client-supplied stable key scoped to authenticated owner and operation",
      "retrySafety": "repeat requests return the original result and never create a second Git change"
    },
    "required": "A future editor service must verify the Cloudflare Access JWT issuer, audience, and signature at request time. An owner email allow-list is defense in depth only.",
    "repositoryData": "No secrets, owner emails, or deployment-specific identifiers belong in this contract."
  }
}
