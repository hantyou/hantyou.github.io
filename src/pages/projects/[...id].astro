---
import "@/styles/callout.css"
import "@/styles/sidenote.css"

import { render, type CollectionEntry } from "astro:content"

import {
  getProjectLinks,
  getProjectNavigation,
  getProjectTypeLabel,
  getProjects,
} from "@/lib/projects"
import { buildMarkdownDocument } from "@/lib/markdown-document"
import { loadAllPublications } from "@/lib/publications/loader"
import Layout from "@/layouts/Layout.astro"
import Badge from "@/components/base/Badge.astro"
import Button from "@/components/base/Button.astro"
import CopyMarkdown from "@/components/base/CopyMarkdown.astro"
import Icon from "@/components/base/Icon.astro"
import DateRange from "@/components/projects/DateRange.astro"
import ProjectNavigation from "@/components/projects/ProjectNavigation.astro"
import ProjectRow from "@/components/projects/ProjectRow.astro"

export async function getStaticPaths() {
  const projects = await getProjects((project) => !!project.body?.trim())

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))
}

type Props = {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
const [{ Content }, navigation] = await Promise.all([
  render(project),
  getProjectNavigation(project.id),
])
const childResearchProjects =
  project.id === "spear"
    ? (
        await getProjects(
          (candidate) => candidate.data.parentProject === project.id,
        )
      ).sort(
        (a, b) => (a.data.timelineOrder ?? 0) - (b.data.timelineOrder ?? 0),
      )
    : []
const parentProject = project.data.parentProject
  ? (
      await getProjects(
        (candidate) => candidate.id === project.data.parentProject,
      )
    )[0]
  : undefined
const relatedPublications = project.data.relatedPublications.length
  ? (await loadAllPublications()).allPublicationsFlat.filter((publication) =>
      project.data.relatedPublications.includes(publication.id),
    )
  : []
const {
  title,
  selected,
  fromDate,
  toDate,
  code,
  doc,
  paper,
  url,
  release,
  types,
  skills,
  researchQuestion,
  contribution,
} = project.data

const links = getProjectLinks(code, doc, paper, url, release)
const rawMarkdown = project.body
  ? buildMarkdownDocument(project.body, {
      title,
      description: project.data.description,
      path: `/projects/${project.id}`,
      date: toDate ?? fromDate,
    })
  : null
---

<Layout
  title={title}
  description={`Project: ${title}`}
  breadcrumbs={[
    { href: "/projects", label: "Research", icon: "research" },
    { label: title, icon: "file" },
  ]}
>
  <header class="project-header">
    {parentProject && (
        <p class="project-parent">
          Part of <a href={`/projects/${parentProject.id}`}>{parentProject.data.title}</a>
        </p>
      )}
    <div class="project-title-row">
      <h1>{title}</h1>
      {selected && (
          <Badge variant="default" class="featured-badge">
            <Icon name="star" class="featured-badge-icon" />
            Featured
          </Badge>
        )}
    </div>
    <div class="project-meta-row">
      <DateRange
        fromDate={fromDate}
        toDate={toDate}
        class="project-date-range"
        showIcon={true}
      />
      {types.map((slug) => <Badge variant="muted">{getProjectTypeLabel(slug)}</Badge>)}
    </div>
    {skills.length > 0 && (
        <div class="project-skills">
          {skills.map((skill) => (
            <Badge variant="accent" class="project-skill">
              {skill}
            </Badge>
          ))}
        </div>
      )}
    {links.length > 0 && (
        <div class="project-links">
          {links.map(({ href, icon, label }) => (
            <Button href={href} variant="accent-outline">
              <Icon name={icon} />
              <span>{label}</span>
            </Button>
          ))}
        </div>
      )}
  </header>

  <article>
    <prose-content>
      <Content />
    </prose-content>
  </article>

  {(researchQuestion || contribution) && (
      <section class="research-context" aria-label="Research context">
        {researchQuestion && (
            <div>
              <p class="research-context-label">Research question</p>
              <p>{researchQuestion}</p>
            </div>
          )}
        {contribution && (
            <div>
              <p class="research-context-label">Contribution</p>
              <p>{contribution}</p>
            </div>
          )}
      </section>
    )}

  {relatedPublications.length > 0 && (
      <section class="related-publications" aria-labelledby="related-publications-title">
        <p class="research-context-label">Related publications</p>
        <h2 id="related-publications-title">Research outputs</h2>
        <ul>
          {relatedPublications.map((publication) => (
            <li>
              {publication.mainUrl ? (
                <a href={publication.mainUrl} target="_blank" rel="noopener noreferrer">
                  {publication.title}
                </a>
              ) : (
                publication.title
              )}
              {publication.publisher && <span>{publication.publisher}</span>}
              {publication.year && <span>{publication.year}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

  {childResearchProjects.length > 0 && (
      <section class="research-strands" aria-labelledby="research-strands-title">
        <p class="research-context-label">My PhD sub-project</p>
        <h2 id="research-strands-title">Multimodal sensing for automotive radar</h2>
        <p>
          These connected research strands form my contribution within SPEAR.
        </p>
        <div class="research-strands-list">
          {childResearchProjects.map((childProject) => <ProjectRow project={childProject} />)}
        </div>
      </section>
    )}

  {rawMarkdown && <CopyMarkdown markdown={rawMarkdown} class="copy-project-markdown" />}

  <ProjectNavigation prev={navigation.prev} next={navigation.next} />
</Layout>

<style>
  .project-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-end: var(--space-xl);
  }

  .project-parent {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .project-parent a {
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--primary) 55%, transparent);
    text-underline-offset: 0.15em;
  }

  .project-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .project-title-row h1 {
    margin: 0;
    font-size: var(--step-3);
    line-height: var(--line-height-tight);
    font-weight: var(--font-weight-bold);
    text-wrap: balance;
  }

  @media (width >= 40rem) {
    .project-title-row h1 {
      font-size: var(--step-4);
    }
  }

  :global(.featured-badge) {
    flex-shrink: 0;
  }

  :global(.featured-badge-icon) {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    margin-inline-end: var(--space-3xs);
  }

  .project-meta-row,
  .project-skills,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .research-context,
  .research-strands,
  .related-publications {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
    padding: var(--space-l);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--muted) 32%, var(--background));
  }

  .research-context {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .research-context > div,
  .research-strands,
  .related-publications {
    display: grid;
    gap: var(--space-3xs);
  }

  .research-context p,
  .research-strands h2,
  .research-strands > p,
  .related-publications h2 {
    margin: 0;
  }

  .research-context-label {
    color: var(--primary);
    font-size: var(--step--2);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .research-strands h2 {
    font-size: var(--step-1);
  }

  .related-publications h2 {
    font-size: var(--step-1);
  }

  .related-publications ul {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    margin: var(--space-2xs) 0 0;
    list-style: none;
  }

  .related-publications li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-xs);
    align-items: baseline;
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--border);
  }

  .related-publications a {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--primary) 60%, transparent);
    text-underline-offset: 0.15em;
  }

  .related-publications li span {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .research-strands > p:not(.research-context-label) {
    color: var(--muted-foreground);
  }

  .research-strands-list {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
    padding-inline-start: 1rem;
  }

  .project-meta-row {
    font-size: var(--step--1);
  }

  :global(.project-date-range) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--muted-foreground);
  }

  :global(.project-skill) {
    font-size: var(--step--1);
  }

  :global(.copy-project-markdown) {
    display: flex;
    justify-content: flex-end;
    margin-block: var(--space-l);
  }
</style>
