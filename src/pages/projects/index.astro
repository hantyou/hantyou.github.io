---
import { FOOTER, PROFILE } from "@site-config"
import techStack from "@/content/tech-stack.json"
import {
  getPrograms,
  getProgramSlugs,
  getProgramStrands,
  getProjects,
} from "@/lib/projects"
import CommonLayout from "@/layouts/CommonLayout.astro"
import Section from "@/components/layout/Section.astro"
import GithubActivity from "@/components/projects/GithubActivity.astro"
import GithubCard from "@/components/projects/GithubCard.astro"
import ProjectRow from "@/components/projects/ProjectRow.astro"
import ResearchTimeline from "@/components/research/ResearchTimeline.astro"
import TechStack from "@/components/projects/TechStack.astro"

const allProjects = await getProjects()
const programSlugs = getProgramSlugs(allProjects)
const programs = getPrograms(allProjects)
  .map((program) => ({
    program,
    strands: getProgramStrands(allProjects, program.id),
  }))
  .filter(({ strands }) => strands.length > 0)
const otherProjects = allProjects.filter(
  (project) => !programSlugs.has(project.id) && !project.data.parentProject,
)

const githubRepo = FOOTER.sourceCode
const githubProfile =
  typeof PROFILE.links.github === "object"
    ? PROFILE.links.github?.href
    : PROFILE.links.github
const githubUsername = githubProfile?.replace(/\/$/, "").split("/").pop()
---

<CommonLayout
  title="Research"
  description="Research projects in autonomous perception, multimodal sensing, and distributed signal processing."
  prose={false}
  breadcrumbs={[{ label: "Research", icon: "research" }]}
  celestial
>
  <div class="projects-page">
    {programs.map(({ program, strands }) => (
      <ResearchTimeline program={program} projects={strands} />
    ))}

    {otherProjects.length > 0 && <div class="projects-list-wrapper">
      <div class="other-research-heading">
        <p class="research-eyebrow">Earlier work and research software</p>
        <h2>Other research</h2>
      </div>
      <div class="project-list">
        {otherProjects.map((project) => <ProjectRow {project} boxed />)}
      </div>
    </div>}

    <Section title="Tech Stack" class="tech-stack-section">
      <TechStack {...techStack} />
      {githubProfile && (
          <section class="tech-stack-activity" aria-labelledby="tech-stack-activity-title">
            <h3 id="tech-stack-activity-title" class="muted-intro">GitHub activity</h3>
            <GithubActivity
              githubUrl={githubProfile}
              compact
              showIntro={false}
              width="full"
            />
          </section>
        )}
    </Section>
    {githubRepo && (
        <Section title="On GitHub" class="github-showcase">
          <GithubCard repo={githubRepo} contributor={githubUsername} />
        </Section>
      )}
  </div>
</CommonLayout>

<style>
  .projects-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .other-research-heading {
    display: grid;
    gap: var(--space-2xs);
  }

  .research-eyebrow {
    margin: 0;
    color: var(--primary);
    font-size: var(--step--2);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .projects-list-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .other-research-heading {
    margin-block-end: var(--space-s);
  }

  .other-research-heading h2 {
    font-size: var(--step-1);
  }

  .tech-stack-activity {
    display: grid;
    gap: var(--space-2xs);
    padding-block-start: var(--space-m);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
</style>
