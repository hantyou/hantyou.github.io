---
import type { ProcessedPublication } from "@/types"
import { getCollection } from "astro:content"

import { PROFILE } from "@site-config"
import { formatCount } from "@/lib/plural"
import { loadAllPublications } from "@/lib/publications/loader"
import { slugify } from "@/lib/string-manipulation"
import CommonLayout from "@/layouts/CommonLayout.astro"
import Button from "@/components/base/Button.astro"
import Dropdown from "@/components/base/Dropdown.astro"
import Icon from "@/components/base/Icon.astro"
import Link from "@/components/base/Link.astro"
import TaxonomyChip from "@/components/base/TaxonomyChip.astro"
import CardGroup from "@/components/base/card/CardGroup.astro"
import Section from "@/components/layout/Section.astro"
import PubCard from "@/components/publications/PubCard.astro"

import "@/styles/chip-filter.css"

const ggScholarUrl =
  typeof PROFILE.links.googleScholar === "object"
    ? PROFILE.links.googleScholar?.href
    : PROFILE.links.googleScholar

const { publicationsByYear, years, allPublicationsFlat, allKeywords } =
  await loadAllPublications()

const equalContributionNote = [
  ...new Set(
    allPublicationsFlat.flatMap((pub) =>
      pub.equalContributionNote ? pub.equalContributionNote.split(". ") : [],
    ),
  ),
].join(". ")
const publicationTypes = [
  ...new Set(
    allPublicationsFlat
      .map((pub) => pub.entryType)
      .filter((type): type is string => Boolean(type)),
  ),
].map((type) => ({
  type,
  label:
    type === "article"
      ? "Journal articles"
      : type === "inproceedings"
        ? "Conference papers"
        : type === "mastersthesis"
          ? "Theses"
          : type,
  count: allPublicationsFlat.filter((pub) => pub.entryType === type).length,
}))

// Project → related-publication mapping for the "?project=" pinned view.
// Reached only from the Research timeline's "Related paper(s)" buttons.
const projectPins = new Map<string, { title: string; pubs: string[] }>()
for (const project of await getCollection("projects")) {
  if (project.data.relatedPublications.length > 0) {
    projectPins.set(project.id, {
      title: project.data.title,
      pubs: project.data.relatedPublications,
    })
  }
}
const projectPinsJson = JSON.stringify([...projectPins.entries()]).replace(
  /</g,
  "\\u003c",
)

// Prominent tags stay visible in one compact row; the rest collapse into a
// disclosure so the filter bar does not dominate the page.
const prominentKeywords = allKeywords.filter(({ count }) => count > 1)
const hiddenKeywords = allKeywords.filter(({ count }) => count === 1)
---

<CommonLayout
  title="Publications"
  description="Publications, preprints, and conference tutorials"
  breadcrumbs={[{ label: "Publications", icon: "research" }]}
  prose={false}
  celestial
>
  {ggScholarUrl && (
      <p class="publication-intro">
        See my full publication list on{" "}
        <Link href={ggScholarUrl} external underline class="publication-scholar-link">
          Google Scholar
        </Link>
        .
      </p>
    )}

  <!-- Controls: sort dropdown + tag filter bar -->
  <div class="pub-controls">
    <div class="pub-sort">
      <Dropdown align="start" id="pub-sort-dropdown">
        <button
          slot="trigger"
          data-dropdown-trigger
          class="pub-sort-trigger"
          aria-label="Sort publications"
        >
          <Icon name="mingcute:sort-descending-line" size={16} />
          <span data-sort-label>By Year</span>
          <Icon name="chevron-down" size={14} />
        </button>
        <button
          data-dropdown-item="year"
          class="pub-sort-option"
          aria-selected="true"
        >
          By Year
        </button>
        <button
          data-dropdown-item="relevance"
          class="pub-sort-option"
          aria-selected="false"
        >
          By Relevance
        </button>
      </Dropdown>
    </div>

    {allKeywords.length > 0 && (
        <div class="publication-tag-controls">
          <div
            class="chip-filter-bar"
            role="group"
            aria-label="Filter publications by tag"
          >
            {prominentKeywords.map(({ keyword, count }) => (
              <TaxonomyChip
                label={keyword}
                count={count}
                countNoun="publication"
                data-pub-tag-filter={slugify(keyword)}
                aria-pressed="false"
                aria-label={`Filter publications by ${keyword}; ${formatCount(count, "publication")}`}
              />
            ))}
            <span class="chip-active-filter" data-active-filter hidden>
              <TaxonomyChip
                label="Clear"
                prefix="×"
                tone="destructive"
                data-clear-filter
                aria-label="Clear publication filter"
              />
            </span>
            <span
              class="sr-only"
              aria-live="polite"
              aria-atomic="true"
              data-publication-filter-status
            />
          </div>
          {hiddenKeywords.length > 0 && (
            <details class="pub-tag-more" data-disclosure>
              <summary>
                <span data-tag-more-show>
                  Show {formatCount(hiddenKeywords.length, "more tag")}
                </span>
                <span data-tag-more-hide>Hide additional tags</span>
                <span data-disclosure-chevron>
                  <Icon name="chevron-down" />
                </span>
              </summary>
              <div class="chip-filter-bar pub-tag-more-chips">
                {hiddenKeywords.map(({ keyword, count }) => (
                  <TaxonomyChip
                    label={keyword}
                    count={count}
                    countNoun="publication"
                    data-pub-tag-filter={slugify(keyword)}
                    aria-pressed="false"
                    aria-label={`Filter publications by ${keyword}; ${formatCount(count, "publication")}`}
                  />
                ))}
              </div>
            </details>
          )}
        </div>
    )}
    {publicationTypes.length > 0 && (
        <div class="publication-type-controls" role="group" aria-label="Filter publications by type">
          <span class="publication-type-label">Type</span>
          <div class="chip-filter-bar">
            {publicationTypes.map(({ type, label, count }) => (
              <TaxonomyChip
                label={label}
                count={count}
                countNoun="publication"
                data-pub-type-filter={type}
                aria-pressed="false"
                aria-label={`Filter publications by ${label}; ${formatCount(count, "publication")}`}
              />
            ))}
          </div>
        </div>
      )}
    {equalContributionNote && (
        <p class="equal-contribution-note" set:html={equalContributionNote} />
      )}
  </div>

  <div class="publication-browse" data-publication-browse>
    <div class="publication-results">
      <!-- Relevance view -->
      <div data-pub-view="relevance" hidden>
        {allPublicationsFlat.length > 0 ? (
            <CardGroup>
              {allPublicationsFlat.map((pub: ProcessedPublication) => (
                <PubCard pub={pub} previewable />
              ))}
            </CardGroup>
          ) : (
            <div class="empty-state">
              <h2>No publications found</h2>
              <p>No publications yet.</p>
            </div>
          )}
      </div>

      <!-- Chronological view (default) -->
      <div data-pub-view="year">
        {years.length > 0 ? (
            years.map((year) => (
              <div data-pub-year-section={year}>
                <Section title={year.toString()}>
                  <CardGroup>
                    {publicationsByYear[year].map((pub: ProcessedPublication) => (
                      <PubCard pub={pub} previewable />
                    ))}
                  </CardGroup>
                </Section>
              </div>
            ))
          ) : (
            <div class="empty-state">
              <h2>No publications found</h2>
              <p>No publications yet.</p>
            </div>
          )}
      </div>
    </div>

    <aside class="publication-preview" aria-label="Publication preview">
      {allPublicationsFlat.map((pub: ProcessedPublication) => (
        <article class="publication-preview-panel" data-publication-preview-panel={pub.id} hidden>
          <div class="publication-preview-header">
            <p class="publication-preview-kicker">{pub.year ?? "Publication"}</p>
            <button
              type="button"
              class="publication-preview-close"
              data-publication-preview-close={pub.id}
              aria-label={`Close preview for “${pub.title}”`}
            >
              <span aria-hidden="true">×</span>
            </button>
          </div>
          <h2>{pub.title}</h2>
          {pub.summary && (
              <div class="publication-preview-block">
                <p class="publication-preview-label">Overview</p>
                <p>{pub.summary}</p>
              </div>
            )}
          {pub.contribution && (
              <div class="publication-preview-block">
                <p class="publication-preview-label">Contribution</p>
                <p>{pub.contribution}</p>
              </div>
            )}
          {pub.project && (
              <div class="publication-preview-block">
                <p class="publication-preview-label">Related research</p>
                <p>{pub.project}</p>
              </div>
            )}
          {pub.keywords.length > 0 && (
              <p class="publication-preview-topics">{pub.keywords.join(" · ")}</p>
            )}
          <div class="publication-preview-actions">
            {pub.mainUrl && <Button href={pub.mainUrl} external variant="primary">Read paper</Button>}
            {pub.links.slice(0, 2).map(({ href, label }) => (
              <Button href={href} external variant="accent-outline">{label}</Button>
            ))}
          </div>
        </article>
      ))}
    </aside>
  </div>
</CommonLayout>

<script
  is:inline
  type="application/json"
  data-project-pins
  set:html={projectPinsJson}
></script>

<script>
  import { initFacetedChipFilter } from "@/lib/chip-filter"

  function initPublicationControls() {
    const relevanceView = document.querySelector<HTMLElement>(
      '[data-pub-view="relevance"]',
    )
    const yearView = document.querySelector<HTMLElement>(
      '[data-pub-view="year"]',
    )
    const sortLabel = document.querySelector<HTMLElement>("[data-sort-label]")
    const sortOptions = document.querySelectorAll<HTMLElement>(
      "#pub-sort-dropdown [data-dropdown-item]",
    )

    if (!relevanceView || !yearView) return

    // astro:page-load and astro:after-swap both fire per navigation; skip the
    // second call so we don't double-bind listeners on this DOM instance
    if (relevanceView.dataset.controlsInitialized === "true") return
    relevanceView.dataset.controlsInitialized = "true"

    let currentSort = "year"

    const chipFilter = initFacetedChipFilter({
      itemSelector: "[data-pub-keywords]",
      facets: [
        {
          key: "tag",
          itemAttr: "pubKeywords",
          filterButtonSelector: "[data-pub-tag-filter]",
          filterButtonAttr: "pubTagFilter",
        },
        {
          key: "type",
          itemAttr: "pubType",
          filterButtonSelector: "[data-pub-type-filter]",
          filterButtonAttr: "pubTypeFilter",
        },
      ],
      groupSelector: "[data-pub-year-section]",
      clearButtonSelector: "[data-clear-filter]",
      activeIndicatorSelector: "[data-active-filter]",
      statusSelector: "[data-publication-filter-status]",
      resultNoun: "publication",
      getScope: () =>
        currentSort === "relevance" ? relevanceView! : yearView!,
    })

    function switchSort(mode: string) {
      currentSort = mode

      relevanceView!.hidden = mode !== "relevance"
      yearView!.hidden = mode !== "year"

      if (sortLabel) {
        sortLabel.textContent =
          mode === "relevance" ? "By Relevance" : "By Year"
      }

      sortOptions.forEach((opt) => {
        opt.setAttribute(
          "aria-selected",
          opt.dataset.dropdownItem === mode ? "true" : "false",
        )
      })

      chipFilter.applyFilter()
    }

    // Sort dropdown clicks
    sortOptions.forEach((opt) => {
      opt.addEventListener("click", () => {
        const value = opt.dataset.dropdownItem
        if (value) switchSort(value)
      })
    })
  }

  function initPublicationPreview() {
    const browse = document.querySelector<HTMLElement>(
      "[data-publication-browse]",
    )
    if (!browse || browse.dataset.previewInitialized === "true") return
    const root = browse
    root.dataset.previewInitialized = "true"

    const cards = [
      ...root.querySelectorAll<HTMLElement>("[data-publication-preview]"),
    ]
    const panels = [
      ...root.querySelectorAll<HTMLElement>("[data-publication-preview-panel]"),
    ]
    const preview = root.querySelector<HTMLElement>(".publication-preview")
    const supportsHover = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches
    const externalPreviewQuery = window.matchMedia("(width >= 84rem)")
    let activeId: string | undefined
    let activeSourceCard: HTMLElement | undefined
    let isPinned = false
    let positionAnimationFrame: number | undefined

    function findVisibleCard(id: string) {
      return cards.find(
        (card) =>
          card.dataset.publicationPreview === id && !card.closest("[hidden]"),
      )
    }

    function placePanel(
      panel: HTMLElement,
      id: string,
      sourceCard?: HTMLElement,
    ) {
      const drawer = sourceCard?.querySelector<HTMLElement>(
        `[data-publication-preview-drawer="${id}"]`,
      )
      const destination = externalPreviewQuery.matches ? preview : drawer
      if (destination && panel.parentElement !== destination) {
        destination.append(panel)
      }
    }

    function updatePreviewPosition() {
      positionAnimationFrame = undefined
      if (!preview || !activeId || !externalPreviewQuery.matches) return

      const sourceCard =
        activeSourceCard?.isConnected && !activeSourceCard.closest("[hidden]")
          ? activeSourceCard
          : findVisibleCard(activeId)
      const panel = panels.find(
        (item) => item.dataset.publicationPreviewPanel === activeId,
      )
      if (!sourceCard || !panel || panel.hidden) return

      const previewStyles = window.getComputedStyle(preview)
      const rootStyles = window.getComputedStyle(document.documentElement)
      const viewportInset = Number.parseFloat(
        previewStyles.getPropertyValue("--publication-preview-viewport-inset"),
      )
      const headerHeight = Number.parseFloat(
        rootStyles.getPropertyValue("--header-height"),
      )
      const inset = Number.isFinite(viewportInset) ? viewportInset : 16
      const minimumTop =
        (Number.isFinite(headerHeight) ? headerHeight : 64) + inset
      const maximumTop = Math.max(
        minimumTop,
        window.innerHeight - inset - panel.offsetHeight,
      )
      const cardTop = sourceCard.getBoundingClientRect().top
      const top = Math.min(Math.max(cardTop, minimumTop), maximumTop)

      preview.style.insetBlockStart = `${top}px`
    }

    function schedulePreviewPosition() {
      if (positionAnimationFrame !== undefined) return
      positionAnimationFrame = window.requestAnimationFrame(
        updatePreviewPosition,
      )
    }

    function show(id: string, pin = false, sourceCard?: HTMLElement) {
      activeId = id
      activeSourceCard = sourceCard ?? findVisibleCard(id)
      if (pin) isPinned = true
      root.dataset.publicationPreviewPinned = String(isPinned)
      panels.forEach((panel) => {
        const isActive = panel.dataset.publicationPreviewPanel === id
        if (isActive) placePanel(panel, id, activeSourceCard)
        panel.hidden = !isActive
      })
      schedulePreviewPosition()
    }

    function clear() {
      if (isPinned) return
      activeId = undefined
      activeSourceCard = undefined
      preview?.style.removeProperty("inset-block-start")
      root.dataset.publicationPreviewPinned = "false"
      panels.forEach((panel) => (panel.hidden = true))
    }

    function close() {
      isPinned = false
      clear()
    }

    cards.forEach((card) => {
      const id = card.dataset.publicationPreview
      if (!id) return
      card.addEventListener("focusin", () => show(id, false, card))
      if (supportsHover) {
        card.addEventListener("mouseenter", () => show(id, false, card))
      } else {
        // Touch devices have no hover state. Let a tap on the card's empty
        // area pin its inline preview; controls and links keep their own
        // behavior.
        card.addEventListener("click", (event) => {
          const target = event.target as HTMLElement
          if (target.closest("a, button, summary, input, select, textarea"))
            return
          if (isPinned && activeId === id) {
            close()
          } else {
            show(id, true, card)
          }
        })
      }
    })

    root
      .querySelectorAll<HTMLButtonElement>("[data-publication-preview-close]")
      .forEach((button) => {
        button.addEventListener("click", close)
      })

    externalPreviewQuery.addEventListener("change", () => {
      if (activeId) show(activeId, isPinned, findVisibleCard(activeId))
    })
    window.addEventListener("scroll", schedulePreviewPosition, {
      passive: true,
    })
    window.addEventListener("resize", schedulePreviewPosition)
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault()
        close()
      }
    })
  }

  function initProjectPinnedPublications() {
    const browse = document.querySelector<HTMLElement>(
      "[data-publication-browse]",
    )
    if (!browse || browse.dataset.pinnedInitialized === "true") return
    browse.dataset.pinnedInitialized = "true"

    const pinsScript = document.querySelector<HTMLScriptElement>(
      "[data-project-pins]",
    )
    if (!pinsScript?.textContent) return

    let projectPins = new Map<string, { title: string; pubs: string[] }>()
    try {
      projectPins = new Map(JSON.parse(pinsScript.textContent))
    } catch {
      return
    }

    const projectId =
      new URLSearchParams(window.location.search).get("project") ?? ""
    const pin = projectId ? projectPins.get(projectId) : undefined
    if (!pin || pin.pubs.length === 0) return

    const views = [
      browse.querySelector<HTMLElement>('[data-pub-view="relevance"]'),
      browse.querySelector<HTMLElement>('[data-pub-view="year"]'),
    ]

    for (const view of views) {
      if (!view) continue

      const cards = pin.pubs
        .map((id) =>
          view.querySelector<HTMLElement>(`[data-publication-preview="${id}"]`),
        )
        .filter((card): card is HTMLElement => Boolean(card))
      if (cards.length === 0) continue

      // Pinned group, styled to match the Section/CardGroup primitives.
      const group = document.createElement("section")
      group.className = "pub-pinned-group"
      group.dataset.pubYearSection = "pinned"
      group.dataset.pubPinned = projectId

      const heading = document.createElement("div")
      heading.className = "pub-pinned-heading"
      const kicker = document.createElement("p")
      kicker.className = "pub-pinned-kicker"
      kicker.textContent = "Related publications"
      const title = document.createElement("h2")
      title.textContent = pin.title
      heading.append(kicker, title)
      group.append(heading)

      // Reuse the global card-group layout for the moved cards.
      const cardsWrap = document.createElement("div")
      cardsWrap.dataset.slot = "card-group"
      cardsWrap.dataset.columns = "1"
      cardsWrap.dataset.breakpoint = "medium"
      cardsWrap.dataset.orientation = "stacked"
      cardsWrap.dataset.separated = "true"
      for (const card of cards) cardsWrap.append(card)
      group.append(cardsWrap)

      // Soft divider between the pinned publications and the rest.
      const divider = document.createElement("div")
      divider.className = "pub-pinned-divider"
      divider.setAttribute("role", "separator")
      const dividerLabel = document.createElement("span")
      dividerLabel.textContent = "All publications"
      divider.append(dividerLabel)

      view.prepend(group)
      group.after(divider)
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      () => {
        initPublicationControls()
        initPublicationPreview()
        initProjectPinnedPublications()
      },
      { once: true },
    )
  } else {
    initPublicationControls()
    initPublicationPreview()
    initProjectPinnedPublications()
  }
  document.addEventListener("astro:page-load", initPublicationControls)
  document.addEventListener("astro:page-load", initPublicationPreview)
  document.addEventListener("astro:after-swap", initPublicationControls)
  document.addEventListener("astro:after-swap", initPublicationPreview)
  document.addEventListener("astro:page-load", initProjectPinnedPublications)
  document.addEventListener("astro:after-swap", initProjectPinnedPublications)
</script>

<style>
  /* Pinned-view group + divider are created client-side, so their styles
     must be global (no Astro scope attribute on the generated elements). */
  :global(.pub-pinned-group) {
    display: grid;
    gap: var(--space-s);
  }

  :global(.pub-pinned-heading) {
    display: grid;
    gap: var(--space-3xs);
    margin-block-start: var(--space-m);
  }

  :global(.pub-pinned-kicker) {
    margin: 0;
    color: var(--primary);
    font-size: var(--step--2);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  :global(.pub-pinned-heading h2) {
    position: relative;
    width: fit-content;
    margin: 0;
    padding-block-end: 0.125rem;
    color: var(--foreground);
    font-size: var(--step-2);
    line-height: 1.333;
    font-weight: var(--font-weight-medium);
  }

  :global(.pub-pinned-heading h2::after) {
    content: "";
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inline-size: 2rem;
    block-size: 2px;
    border-radius: 1px;
    background: var(--primary);
    opacity: 0.7;
  }

  :global(.pub-pinned-divider) {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-block: var(--space-xl) var(--space-l);
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  :global(.pub-pinned-divider::before),
  :global(.pub-pinned-divider::after) {
    content: "";
    flex: 1;
    block-size: 1px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in oklab, var(--border) 75%, transparent)
    );
  }

  :global(.pub-pinned-divider::after) {
    background: linear-gradient(
      to left,
      transparent,
      color-mix(in oklab, var(--border) 75%, transparent)
    );
  }

  .publication-tag-controls {
    min-inline-size: 0;
  }

  .pub-tag-more {
    margin-block-start: var(--space-3xs);
  }

  .pub-tag-more summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    min-block-size: var(--control-size-compact);
    padding-inline: var(--space-2xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    cursor: pointer;
    list-style: none;
    transition:
      border-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease);
  }

  [data-tag-more-hide] {
    display: none;
  }

  .pub-tag-more[open] [data-tag-more-show] {
    display: none;
  }

  .pub-tag-more[open] [data-tag-more-hide] {
    display: inline;
  }

  .pub-tag-more-chips {
    margin-block-start: var(--space-3xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .pub-tag-more summary:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  .pub-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .publication-type-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .publication-type-label {
    color: var(--muted-foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
  }

  .publication-intro,
  .equal-contribution-note,
  .empty-state {
    color: var(--muted-foreground);
  }

  .publication-scholar-link {
    color: var(--foreground);
  }

  .equal-contribution-note {
    inline-size: 100%;
    font-size: var(--step--1);
  }

  .empty-state {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .empty-state h2 {
    margin-block: 0 var(--space-2xs);
    color: var(--muted-foreground);
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
  }

  .pub-sort-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--background);
    color: var(--foreground);
    cursor: pointer;
